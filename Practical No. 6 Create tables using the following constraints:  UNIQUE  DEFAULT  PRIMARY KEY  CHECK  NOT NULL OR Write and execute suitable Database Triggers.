CREATE TABLE account (
  accno   NUMBER PRIMARY KEY,
  holder  VARCHAR2(30) NOT NULL,
  email   VARCHAR2(30) UNIQUE,
  balance NUMBER CHECK (balance >= 500),
  branch  VARCHAR2(15) DEFAULT 'Loni'
);
