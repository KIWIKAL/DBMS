-- OR: Trigger
CREATE OR REPLACE TRIGGER trg_bal_update
AFTER UPDATE OF balance ON account
FOR EACH ROW
BEGIN
  DBMS_OUTPUT.PUT_LINE('Old: ' || :OLD.balance || ' New: ' || :NEW.balance);
END;
