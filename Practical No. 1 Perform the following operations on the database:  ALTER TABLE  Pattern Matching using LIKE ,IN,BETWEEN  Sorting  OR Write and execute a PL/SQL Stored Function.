-- OR: Function
CREATE OR REPLACE FUNCTION get_grade(p_roll NUMBER) RETURN VARCHAR2 IS
  m NUMBER;
BEGIN
  SELECT marks INTO m FROM student WHERE rollno = p_roll;
  IF m >= 75 THEN RETURN 'Distinction';
  ELSIF m >= 60 THEN RETURN 'First Class';
  ELSE RETURN 'Pass';
  END IF;
END;
/
